{
  # Email for Let's Encrypt certificates (optional but recommended)
  # email you@example.com
}

# Main app (Simulator). Configure SIM_DOMAIN to a real hostname for public use.
# With a hostname, Caddy will:
# - obtain/renew TLS certs automatically (Let's Encrypt)
# - redirect HTTP -> HTTPS
{$SIM_DOMAIN:localhost} {
  encode gzip

  # Serve the Flask simulator.
  # The /admin area remains protected by the simulator's own ADMIN_USER/
  # ADMIN_PASSHASH login and is intentionally independent from Orthanc access.
  reverse_proxy simulator:5000
}

# Public Orthanc/PACS UI on a separate hostname.
#
# Orthanc Explorer uses POST for read-only database queries such as /tools/find,
# so POST cannot be blocked globally. We allow the known read-only query endpoints
# required by the UI, while blocking all other POST requests plus PUT/PATCH/DELETE.
# The simulator is unaffected because it talks to Orthanc directly over the
# internal Docker network (http://orthanc:8042).
{$ORTHANC_DOMAIN:orthanc.localhost} {
  encode gzip

  # Always block methods that mutate existing Orthanc resources.
  @orthanc_mutating_methods {
    method PUT PATCH DELETE
  }
  respond @orthanc_mutating_methods "Public Orthanc access is read-only." 403

  # POST is also used by Orthanc for read-only searches. Permit only those
  # endpoints needed to browse/search studies; block every other public POST.
  @orthanc_blocked_post {
    method POST
    not path /tools/find /tools/lookup
  }
  respond @orthanc_blocked_post "Public Orthanc access is read-only." 403

  reverse_proxy orthanc:8042
}
