{
  # Email for Let's Encrypt certificates (optional but recommended)
  # email you@example.com
}

# Main app (Simulator). Configure SIM_DOMAIN to a real hostname for public use.
# With a hostname, Caddy will:
# - obtain/renew TLS certs automatically (Let's Encrypt)
# - redirect HTTP -> HTTPS
{$SIM_DOMAIN:localhost} {
  encode gzip

  # Serve the Flask simulator.
  # The /admin area remains protected by the simulator's own ADMIN_USER/
  # ADMIN_PASSHASH login and is intentionally independent from Orthanc access.
  reverse_proxy simulator:5000
}

# Public Orthanc/PACS UI on a separate hostname.
#
# Orthanc itself stays bound to localhost/Docker internally. Caddy is the only
# public entry point. Browsing studies and images does not require a password,
# while mutating HTTP methods are blocked at the reverse proxy so public users
# cannot upload, modify or delete PACS data through the Orthanc REST API/UI.
#
# The simulator is unaffected by this restriction because it talks to Orthanc
# directly over the internal Docker network (http://orthanc:8042).
{$ORTHANC_DOMAIN:orthanc.localhost} {
  encode gzip

  @orthanc_write {
    method POST PUT PATCH DELETE
  }
  respond @orthanc_write "Public Orthanc access is read-only." 403

  reverse_proxy orthanc:8042
}
