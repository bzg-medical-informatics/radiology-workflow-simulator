# Cloudflare/Caddy example for bohn-teaching.org
#
# Usage:
#   cp .env.example .env
#   # Replace all CHANGE_ME values before deployment.
#   docker compose -f docker-compose.server.yml up -d --build
#
# Never commit the resulting .env file.

# Public domains. Both DNS A/AAAA records must point to the server.
# Simulator for students and teachers:
SIM_DOMAIN=orthanc.bohn-teaching.org
# Public read-only Orthanc/PACS web UI (no login required):
ORTHANC_DOMAIN=pacs.bohn-teaching.org
ORTHANC_PUBLIC_URL=https://pacs.bohn-teaching.org

# Required: Flask session and cookie signing key.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_HEX_STRING

# Password-protected teacher dashboard at https://orthanc.bohn-teaching.org/admin
ADMIN_USER=admin
# Recommended: bcrypt hash. Generate with:
# docker compose -f docker-compose.server.yml run --rm caddy caddy hash-password --plaintext 'YOUR_PASSWORD'
# Put the complete hash in single quotes so Docker Compose preserves every $.
# Example: ADMIN_PASSHASH='$2a$14$...'
ADMIN_PASSHASH='CHANGE_ME_TO_A_BCRYPT_HASH'
# Leave empty when ADMIN_PASSHASH is set.
ADMIN_PASSWORD=

# The PACS hostname intentionally does not reuse ADMIN_USER/ADMIN_PASSHASH.
# Caddy exposes Orthanc without login but blocks POST/PUT/PATCH/DELETE publicly.
# The simulator can still write to Orthanc over the internal Docker network.

# Creates this number of student session keys if no sessions exist yet.
AUTO_GENERATE_SESSIONS=30
