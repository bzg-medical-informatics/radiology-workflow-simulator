# Beispiel für den zentralen Server
#
# Nutzung:
#   1) Datei kopieren: cp .env.server.example .env
#   2) Werte setzen
#   3) Start: docker compose -f docker-compose.server.yml up -d --build
#
# WICHTIG: Diese Datei enthält nur Platzhalter.
#          Eine echte .env niemals ins Repo committen.

# REQUIRED: Flask Session / CSRF / Cookie Signierung
# Erzeuge z.B. einen Wert mit:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY="CHANGE_ME_TO_A_RANDOM_HEX_STRING"

# REQUIRED (recommended): Aktiviert die passwortgeschützte /admin-Konsole
# zum Generieren und Verwalten der Session-Codes.
ADMIN_USER="admin"
ADMIN_PASSHASH=""

# Legacy (plaintext) Fallback; besser leer lassen und ADMIN_PASSHASH setzen.
ADMIN_PASSWORD=""

# OPTIONAL: Anzahl automatisch erzeugter Session-Codes beim ersten Start
AUTO_GENERATE_SESSIONS=20

# OPTIONAL: Öffentliche Orthanc-URL für Links im Simulator.
# Wenn ORTHANC_DOMAIN gesetzt ist, kann hier dieselbe HTTPS-URL eingetragen werden.
ORTHANC_PUBLIC_URL=""

# OPTIONAL: Orthanc über Caddy als eigene öffentliche PACS-Subdomain bereitstellen.
# Der öffentliche Zugriff benötigt kein Passwort, ist aber im Caddy-Proxy read-only:
# GET/HEAD zum Anzeigen sind erlaubt; POST/PUT/PATCH/DELETE werden blockiert.
# Der Simulator selbst schreibt weiterhin intern direkt nach Orthanc.
ORTHANC_DOMAIN=""

# OPTIONAL: Öffentlicher Hostname für den Simulator (HTTPS via Caddy)
# Empfehlung: sim.example.org oder eine Schul-Subdomain (A/AAAA -> Server-IP).
# Wichtig: SIM_DOMAIN muss genau dem Host entsprechen, den SuS im Browser aufrufen.
# Fallback ohne Domain (kein Let's-Encrypt-HTTPS): setze SIM_DOMAIN auf die öffentliche IP.
# Dann erreichst du die App typischerweise nur via http://<SERVER-IP>/ (Port 80 muss offen sein).
SIM_DOMAIN=""

# Hinweis zu bcrypt in .env:
# - Der Hash wird nur für die Admin-Konsole verwendet.
# - Hashes enthalten '$'. Setze den vollständigen Hash in einfache Anführungszeichen.
# - Beispiel: ADMIN_PASSHASH='$2a$14$....'
